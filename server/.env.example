PORT=5050

# Paste the full contents of your Firebase service account JSON file as one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Optional. Your Firebase Storage bucket name, e.g. your-project.appspot.com
# Leave this blank if you're on the free Spark plan without Storage enabled yet —
# PDFs will be saved to server/uploads/ on local disk instead. Fill this in once
# you upgrade to the Blaze plan to switch to Firebase Storage.
FIREBASE_STORAGE_BUCKET=

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
